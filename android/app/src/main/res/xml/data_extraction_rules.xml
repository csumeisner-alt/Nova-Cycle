<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup/restore rules for Android 12+ (android:dataExtractionRules).
  Mirrors backup_rules.xml — see that file for the rationale.

  Both cloud-backup (Google One backup → reinstall restore) and
  device-transfer (new-phone cable/wifi copy) carry the tap achievement,
  theme unlocks and user settings.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="nova_prefs.xml" />
        <include domain="file" path="datastore/novacycle_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="nova_prefs.xml" />
        <include domain="file" path="datastore/novacycle_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
