<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NovaCycle dark theme — base for the app -->
    <style name="Theme.NovaCycle" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nc_gold</item>
        <item name="colorOnPrimary">@color/nc_bg_primary</item>
        <item name="colorPrimaryContainer">@color/nc_bg_elevated</item>
        <item name="colorOnPrimaryContainer">@color/nc_text_primary</item>
        <item name="colorSecondary">@color/nc_red</item>
        <item name="colorOnSecondary">@color/nc_text_primary</item>
        <item name="android:colorBackground">@color/nc_bg_primary</item>
        <item name="colorSurface">@color/nc_bg_surface</item>
        <item name="colorOnSurface">@color/nc_text_primary</item>
        <item name="colorSurfaceVariant">@color/nc_bg_card</item>
        <item name="colorOnSurfaceVariant">@color/nc_text_secondary</item>
        <item name="android:windowBackground">@color/nc_bg_primary</item>
        <item name="android:statusBarColor">@color/nc_bg_primary</item>
        <item name="android:navigationBarColor">@color/nc_bg_surface</item>
    </style>

    <!-- Activity entry theme — kept as an alias of the main app theme so the
         manifest reference remains valid while launching directly into Compose. -->
    <style name="Theme.NovaCycle.Splash" parent="Theme.NovaCycle" />
</resources>
