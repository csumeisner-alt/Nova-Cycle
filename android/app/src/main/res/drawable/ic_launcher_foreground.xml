<?xml version="1.0" encoding="utf-8"?>
<!--
    NovaCycle launcher icon foreground — a stylised cycle/wave mark on a transparent background.
    Renders on top of ic_launcher_background (solid #0D0D0D dark).
    Safe-zone is the inner 66 × 66 dp of the 108 × 108 viewportWidth/Height.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- "NC" lettermark — centred in the safe zone -->

    <!-- Left vertical bar of N -->
    <path
        android:fillColor="#FF00C896"
        android:pathData="M34,32 L34,76 L40,76 L40,32 Z" />

    <!-- Diagonal stroke of N -->
    <path
        android:fillColor="#FF00C896"
        android:pathData="M34,32 L40,32 L74,76 L68,76 Z" />

    <!-- Right vertical bar of N -->
    <path
        android:fillColor="#FF00C896"
        android:pathData="M68,32 L74,32 L74,76 L68,76 Z" />

    <!-- Small cycle arc — bottom accent (signals the "cycle" concept) -->
    <path
        android:strokeColor="#FF6EE7B7"
        android:strokeWidth="3"
        android:fillColor="@android:color/transparent"
        android:pathData="M38,84 Q54,78 70,84" />

</vector>
