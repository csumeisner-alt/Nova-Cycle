# Replit environment files
.pythonlibs/
.upm/
.config/
**/.config/

# Old NovaCycle backup
android-novacycle-backup/

# pnpm workspace packages needed for EAS install (pnpm-lock.yaml is also included)
# Note: artifacts/, lib/, and scripts/ are excluded from git but must be in the EAS archive
# because the root package.json is part of a pnpm workspace. EAS upload uses .easignore, not .gitignore.
!artifacts/
!lib/
!scripts/

# Build cache
.cache/
.expo/
.expo-shared/

# Dependencies
node_modules/
**/.config/npm/

# Lock files / package managers not used by EAS
package-lock.json
uv.lock
pyproject.toml

# IDE / system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-error.log*

# Git
.git/

# Replit config
.replit
.replitignore
