# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit runtime (not source)
.cache/
.local/
.config/
.upm/
.pythonlibs/

# Android build outputs — source is tracked, generated files are not
android/build/
android/app/build/
android/.gradle/
android/local.properties

# Android signing — debug.keystore is intentionally kept (debug only, no secrets)
# android/app/debug.keystore  ← tracked so anyone can build without setup

# Firebase config — contains project credentials, must be added manually
android/app/google-services.json

# Python artifacts
uv.lock
pyproject.toml

# Unused lock / config files
package-lock.json
attached_assets

# Transient ML runtime state (model reports/calibration written at train time)
artifacts/api-server/backend/ml/models/*.json
artifacts/api-server/backend/ml/models/*.json.bak
