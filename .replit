modules = ["nodejs-20", "nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backend-tests"

[[workflows.workflow]]
name = "backend-tests"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server/backend && python -m pytest -q"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "ocl-icd", "opencl-headers", "openjpeg", "psmisc", "tcl", "tk", "zlib"]

[userenv]

[userenv.shared]
EAS_PROJECT_ID = "c2d9e634-8369-49d1-b640-6381c60c5fd4"
ANDROID_HOME = "/home/runner/Android/Sdk"
JAVA_HOME = "/nix/store/1nm9vlcping44gr405fyd67kar2fqlcb-temurin-bin-17.0.14"
PATH = "/nix/store/1nm9vlcping44gr405fyd67kar2fqlcb-temurin-bin-17.0.14/bin:/home/runner/Android/Sdk/cmdline-tools/latest/bin:/home/runner/Android/Sdk/platform-tools:/home/runner/Android/Sdk/build-tools/35.0.0:/home/runner/.local/share/pnpm:/home/runner/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
